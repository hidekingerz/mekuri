{
  "name": "mekuri",
  "private": true,
  "version": "1.14.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "biome check src/ e2e/ playwright.config.ts",
    "format": "biome format --write src/ e2e/ playwright.config.ts",
    "format:check": "biome format src/ e2e/ playwright.config.ts",
    "test": "vitest run",
    "test:e2e": "tsc -p tsconfig.e2e.json && playwright test",
    "test:mutation": "mutator"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@biomejs/biome": "^2.3.14",
    "@mizchi/mutator": "0.4.0",
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.11",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.1.1"
