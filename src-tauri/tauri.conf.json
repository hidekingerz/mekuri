{
  "$schema": "https://raw.githubusercontent.com/nicehash/tauri/v2/crates/tauri-cli/schema.json",
  "productName": "mekuri",
  "version": "1.7.0",
  "identifier": "com.mekuri.reader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "mekuri",
        "width": 1000,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": ["zip", "cbz"],
        "name": "ZIP archive",
        "mimeType": "application/zip",
        "role": "Viewer"
      },
      {
        "ext": ["rar", "cbr"],
        "name": "RAR archive",
        "mimeType": "application/vnd.rar",
        "role": "Viewer"
      },
      {
        "ext": ["pdf"],
        "name": "PDF document",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {}
}
